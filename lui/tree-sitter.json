{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lui",
      "camelcase": "Lui",
      "title": "Lui",
      "scope": "source.lui",
      "file-types": ["lui"],
      "injection-regex": "^lui$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A tree-sitter parser for .lui, the markup of Lyra's bindings.imgui.ui",
    "authors": [{ "name": "Avram Eisner", "email": "avrame@gmail.com" }],
    "links": { "repository": "https://github.com/Lyra-Language/tree-sitter-lyra" }
  }
}
